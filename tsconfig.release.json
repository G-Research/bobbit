{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "files": [
    "scripts/release/dist-tag-guard.mjs",
    "scripts/release/release-contract.mjs",
    "scripts/release/validate-release-commit.mjs",
    "scripts/release/changelog-section.mjs"
  ]
}
